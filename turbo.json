{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "eslint.config.mjs",
    "base-tsconfig.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL"
      ]
    },
    "clean": {
      "cache": false
    },
    "extension#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env"
      ],
      "outputs": [
        ".output/**"
      ],
      "env": [
        "WXT_API_URL"
      ]
    },
    "extension#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "WXT_API_URL"
      ]
    }
  }
}
