{
  "name": "bookbot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=web --filter=worker",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "npm run migrate:deploy -w @bookbot/db"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "dependencies": {
    "types": "^0.1.1",
    "zod": "^3.23.0"
  },
  "packageManager": "npm@10.0.0"
}
