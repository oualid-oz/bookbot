{
  "name": "extension",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "wxt prepare && tsc --noEmit && wxt build",
    "start": "wxt",
    "lint": "eslint",
    "clean": "rm -rf .wxt dist",
    "test": "wxt prepare && vitest run",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "node --env-file-if-exists=../../.env scripts/check-api-url.mjs && wxt prepare && tsc --noEmit && wxt zip",
    "icons": "node scripts/make-icons.mjs",
    "dev": "wxt"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "eslint": "^9",
    "linkedom": "^0.18.0",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
