# Database
DATABASE_URL=

# Redis
REDIS_URL=

# Storage driver: local (default, files in .data/storage; web and worker must
# share the directory), r2 (uses the R2_* settings below), or s3 (S3_* below)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=

# Any S3-compatible service (MinIO, AWS S3, ...), used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# R2/S3 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Extension
EXTENSION_JWT_SECRET=
