# Database
DATABASE_URL=

# Redis
REDIS_URL=

# File storage: local (files in .data/storage; web and worker must share the
# directory), vercel-blob, r2 or s3. Left empty, it's picked from what's set
# below: vercel-blob when BLOB_READ_WRITE_TOKEN is set (Vercel adds it when you
# connect a Blob store), then r2, then s3, else local.
FILE_STORAGE=
STORAGE_LOCAL_DIR=

# Vercel Blob (production on Vercel): added automatically when a Blob store
# is connected to the project
BLOB_READ_WRITE_TOKEN=

# Any S3-compatible service (MinIO, AWS S3, ...), used when FILE_STORAGE=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare R2, used when FILE_STORAGE=r2. The bucket also needs a CORS rule
# allowing PUT from your site, since image uploads go straight from the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email: "console" prints emails (with their links) to the server log.
# Add a provider transport in apps/web/src/server/email.ts for production.
EMAIL_TRANSPORT=console

# Chrome extension build: where the extension sends API requests
WXT_API_URL=http://localhost:3000
